<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.code2wiki.git-state</string>

    <!--
      LaunchAgent: regenerates git-state.html every 60s so worktree add/remove
      and any state that git hooks don't cover stays current. User-level agent;
      runs only while logged in (fine for a developer dashboard).

      Install:
        cp tools/scripts/com.code2wiki.git-state.plist ~/Library/LaunchAgents/
        launchctl load ~/Library/LaunchAgents/com.code2wiki.git-state.plist
      Reload after edits:
        launchctl unload ~/Library/LaunchAgents/com.code2wiki.git-state.plist
        launchctl load   ~/Library/LaunchAgents/com.code2wiki.git-state.plist
    -->

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/aaronquincylongnion/code2wiki/tools/scripts/generate_git_state.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aaronquincylongnion/code2wiki</string>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/aaronquincylongnion</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aaronquincylongnion/code2wiki/logs/git-state/agent-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/aaronquincylongnion/code2wiki/logs/git-state/agent-stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>15</integer>
</dict>
</plist>
