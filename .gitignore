git-state.html
logs/git-state/

# Local c2w workflow snapshot dashboard
.c2w-workflow.html



# Local browser-clickable preview output of code2wiki preview against
# references/<repo>/ (2026-05-16 customer-demo showcase). Per-repo
# preview lives in references/<repo>/.code2wiki/preview already; this
# top-level dir aggregates them via symlinks for a single-URL demo.
.code2wiki-showcase/
