# Copy this file to .env and fill in your real values.
# .env is gitignored — never committed.

# Required for real LLM extraction. Without this, the CLI runs in mock mode
# and produces clearly-marked DRAFT pages so the pipeline still works end-to-end.
ANTHROPIC_API_KEY=

# Optional — override the default Claude model used for extraction.
# Default in code2wiki.config.json is claude-sonnet-4-6.
# CODE2WIKI_MODEL=claude-sonnet-4-6

# Optional — force mock mode even if a key is set (useful for CI / testing).
# CODE2WIKI_MOCK=1

# ─── Confluence publisher (only needed for `code2wiki publish confluence`) ───
# CONFLUENCE_BASE_URL=https://yourorg.atlassian.net/wiki
# CONFLUENCE_EMAIL=you@yourorg.com
# CONFLUENCE_API_TOKEN=        # from https://id.atlassian.com/manage-profile/security/api-tokens
# CONFLUENCE_SPACE_KEY=DOCS    # the space key (e.g. ENG, DOCS, TEAM)
# CONFLUENCE_PARENT_PAGE_ID=   # optional: a parent page so all use cases nest under it
# CONFLUENCE_LABEL=code2wiki   # optional: label applied to every published page

# ─── Notion publisher (only needed for `code2wiki publish notion`) ───
# Create an internal integration at https://www.notion.so/my-integrations,
# then share the destination database with that integration.
# The database must have a Rich Text property named "code2wiki_id".
# NOTION_API_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID=xxxxxxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NOTION_API_VERSION=2022-06-28
